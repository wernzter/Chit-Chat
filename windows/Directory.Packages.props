<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DesktopUiVersion>11.3.20</DesktopUiVersion>
    <SpeechRuntimeVersion>1.13.5</SpeechRuntimeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="$(DesktopUiVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(DesktopUiVersion)" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="$(DesktopUiVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(DesktopUiVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(DesktopUiVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(DesktopUiVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(DesktopUiVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(DesktopUiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="NAudio" Version="2.3.0" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="$(SpeechRuntimeVersion)" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="$(SpeechRuntimeVersion)" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="$(SpeechRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
